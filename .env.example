# =============================================================================
# Satellite-Based Industrial Fire & Thermal Source Attribution
# SIH 2026 – PS 26162  |  Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── NASA FIRMS MAP_KEY ──────────────────────────────────────────────────────
# Required for live FIRMS API access.
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/
# If not set, the pipeline expects FIRMS_LOCAL_FILE instead.
FIRMS_MAP_KEY=your_firms_map_key_here

# ── FIRMS Local Dataset Fallback ─────────────────────────────────────────────
# If MAP_KEY is unavailable, set this to the path of an officially downloaded
# FIRMS VIIRS CSV file.
# Download from: https://firms.modaps.eosdis.nasa.gov/download/
# Example: data/raw/fire_archive_VIIRS_NOAA20_NRT_India_2024.csv
FIRMS_LOCAL_FILE=

# ── Target Region Bounding Box ───────────────────────────────────────────────
# FIRMS API format: West,South,East,North
# Default is India.
FIRMS_BBOX=67,6,98,37

# ── FIRMS Lookback Days (for NRT API) ────────────────────────────────────────
# Number of days of data to request (max 10 for NRT API; use archive for more)
FIRMS_DAYS=10

# ── FIRMS Dataset Name ───────────────────────────────────────────────────────
# Options: VIIRS_NOAA20_NRT, VIIRS_SNPP_NRT, MODIS_NRT
FIRMS_DATASET=VIIRS_NOAA20_NRT

# ── Spatial Persistence Radius ───────────────────────────────────────────────
# Radius in kilometres for matching nearby events when calculating
# 7-day temporal persistence features.
# Default: 1.0 km.  Increase for sensitivity testing.
PERSISTENCE_RADIUS_KM=1.0

# ── OSM Enrichment Cache Directory ───────────────────────────────────────────
# Where to cache Overpass API results so repeated runs don't re-query.
OSM_CACHE_DIR=data/raw/osm_cache

# ── Labeling Proximity Thresholds (km) ───────────────────────────────────────
LABEL_INDUSTRIAL_KM=2.0
LABEL_MINING_KM=2.0
LABEL_FOREST_KM=1.0
LABEL_AGRICULTURAL_KM=2.0

# ── Spatial Train/Test Split ──────────────────────────────────────────────────
# Latitude below which events are assigned to the TEST set.
# Default: 15.0 (southern India held out as test region)
SPATIAL_SPLIT_LAT=15.0

# ── Random seed ───────────────────────────────────────────────────────────────
RANDOM_SEED=42
